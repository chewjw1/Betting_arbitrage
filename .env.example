# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/betting_arbitrage
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/betting_arbitrage

# Redis
REDIS_URL=redis://localhost:6379/0

# Kalshi API (authenticated = higher rate limits + order book depth)
# 1. Create account at kalshi.com
# 2. Go to Settings > API Keys > Generate new key
# 3. Save the private key PEM file and note your API key ID
KALSHI_API_KEY=your_kalshi_api_key
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
KALSHI_API_HOST=https://api.elections.kalshi.com
# Demo environment for testing (no real money):
# KALSHI_API_HOST=https://demo-api.kalshi.co
# Categories to fetch (comma-separated). Kalshi has: Politics, Economics, Crypto,
# Elections, Financials, Climate and Weather, Companies, World, Health,
# Science and Technology, Education, Mentions, Social, Transportation, Entertainment, Sports
KALSHI_CATEGORIES=Politics,Economics,Crypto,Elections,Financials,Climate and Weather,World
KALSHI_MAX_MARKETS=2000

# Polymarket API
POLYMARKET_API_HOST=https://clob.polymarket.com
# For authenticated trading (optional):
# POLYMARKET_API_KEY=your_api_key
# POLYMARKET_API_SECRET=your_api_secret
# POLYMARKET_PASSPHRASE=your_passphrase

# PredictIt API (no auth needed)
PREDICTIT_API_HOST=https://www.predictit.org

# DraftKings API (no auth required for public data)
DRAFTKINGS_BASE_URL=https://predictions.draftkings.com

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_channel_id_for_alerts
DISCORD_GUILD_ID=your_server_id

# Arbitrage Settings
MIN_NET_SPREAD_PCT=1.0  # Minimum net profit percentage to alert
MAX_POSITION_SIZE=500  # Maximum dollars per side

# Polling interval - 10 min allows LLM validation to complete between scans
# Structural spreads persist for hours/days, so frequent polling isn't needed.
API_POLL_INTERVAL_SECONDS=600    # All platforms (every 10 min)

# Deduplication: Don't re-notify for same market pair within this window
NOTIFICATION_COOLDOWN_SECONDS=300  # 5 minutes

# LLM Match Validation (highly recommended - filters false positive matches)
# Uses GPT-4o-mini: $0.15/$0.60 per M tokens (~$0.01/day for typical usage)
OPENAI_API_KEY=sk-...
LLM_VALIDATION_ENABLED=true

# API Settings
API_HOST=0.0.0.0
API_PORT=44495

# Logging
LOG_LEVEL=INFO
